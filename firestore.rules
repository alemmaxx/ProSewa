rules_version = '2';
// ProSewa — Firestore Security Rules untuk database "prosewa" (projek kukusanmy)
// Firebase Console → Firestore Database → pilih database "prosewa" → Rules → tampal → Publish
// (Rules database "(default)" KUKUSAN tidak terlibat.)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSuper() { return signedIn() && request.auth.uid == 'D3U6Dxs5joZQq5EYRdjZQUmRV773'; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function tenant(tok) { return get(/databases/$(database)/documents/tenants/$(tok)).data; }
    function ownsTenant(tok) { return signedIn() && (tenant(tok).ownerId == request.auth.uid || isSuper()); }

    // Profil awam owner (nama, telefon, bank, tetapan peringatan) — dibaca oleh penyewa
    match /owners/{uid} {
      allow get: if true;
      allow list: if isSuper();
      allow create, update: if isMe(uid) || isSuper();
      allow delete: if isSuper();
    }

    // Maklumat peribadi owner (emel) — owner sendiri & Super Admin sahaja
    match /ownerPriv/{uid} {
      allow read, write: if isMe(uid) || isSuper();
    }

    // Langganan — owner hanya boleh mula percubaan sekali; lain-lain Super Admin (atau Cloud Function ToyyibPay)
    match /subs/{uid} {
      allow get: if true;
      allow list: if isSuper();
      allow create: if isSuper() || (isMe(uid)
        && request.resource.data.keys().hasOnly(['plan', 'startTs'])
        && request.resource.data.plan == 'trial'
        && request.resource.data.startTs == request.time);
      allow update, delete: if isSuper();
    }

    // Tetapan sistem (hari percubaan, harga pakej)
    match /config/{id} {
      allow read: if true;
      allow write: if isSuper();
    }

    // Sejarah bayaran langganan
    match /subPayments/{id} {
      allow read: if isSuper() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow write: if isSuper();
    }

    // Belanja sistem Super Admin (laporan kewangan)
    match /sysExpenses/{id} {
      allow read, write: if isSuper();
    }

    // Pesanan bayaran ToyyibPay (ditulis oleh Cloud Function sahaja)
    match /subOrders/{id} {
      allow read: if isSuper() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Kod promo langganan — Super Admin sahaja (owner guna melalui Cloud Function prosewaRedeemPromo)
    match /promos/{code} {
      allow read, write: if isSuper();
    }

    // Peranti untuk push notification (FCM) — ID dokumen = token FCM. Dibaca oleh Cloud Function sahaja.
    match /devices/{id} {
      allow read, delete: if false;
      allow create, update: if request.resource.data.lang in ['bm', 'en']
        && request.resource.data.platform in ['web', 'android']
        && request.resource.data.at is string
        && ((signedIn() && request.resource.data.keys().hasOnly(['uid', 'lang', 'platform', 'at']) && request.resource.data.uid == request.auth.uid)
          || (request.resource.data.keys().hasOnly(['tok', 'lang', 'platform', 'at']) && request.resource.data.tok is string
            && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tok))
            && get(/databases/$(database)/documents/tenants/$(request.resource.data.tok)).data.active == true));
    }

    // Pemantau sistem — butiran untuk Super Admin sahaja (ditulis oleh Cloud Function)
    match /health/{id} {
      allow read: if isSuper();
      allow write: if false;
    }

    // Ralat app & laporan masalah pengguna — sesiapa boleh hantar (saiz terhad), hanya Super Admin boleh baca / padam
    match /sysErrors/{id} {
      // owner boleh baca laporan sendiri (status & balasan Super Admin)
      allow read: if isSuper() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow delete: if isSuper();
      allow update: if isSuper() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'repliedAt', 'lastMsgAt', 'lastFrom']);
      // Chat laporan: Super Admin ↔ owner yang melapor sahaja
      match /msgs/{m} {
        function rep() { return get(/databases/$(database)/documents/sysErrors/$(id)).data; }
        allow read: if isSuper() || (signedIn() && rep().get('uid', '') == request.auth.uid);
        allow create: if request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.at is string && request.resource.data.at.size() <= 20
          && ((isSuper() && request.resource.data.from == 'super') || (signedIn() && rep().get('uid', '') == request.auth.uid && request.resource.data.from == 'owner'));
      }
      allow create: if request.resource.data.keys().hasOnly(['src', 'where', 'msg', 'at', 'ver', 'ua', 'who', 'contact', 'uid'])
        && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.src in ['web', 'apk', 'report']
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 1000
        && request.resource.data.at is string && request.resource.data.at.size() <= 20
        && request.resource.data.get('where', '').size() <= 100
        && request.resource.data.get('ua', '').size() <= 200
        && request.resource.data.get('who', '').size() <= 120
        && request.resource.data.get('contact', '').size() <= 120;
    }

    // Hartanah (rumah & bilik) owner
    match /properties/{id} {
      allow read, delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isSuper());
      allow update: if signedIn() && (resource.data.ownerId == request.auth.uid || isSuper()) && request.resource.data.ownerId == resource.data.ownerId;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Bil berulang owner (IWK, maintenance, internet…) — dijana sebagai perbelanjaan setiap bulan
    match /recurring/{id} {
      allow read, delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isSuper());
      allow update: if signedIn() && (resource.data.ownerId == request.auth.uid || isSuper()) && request.resource.data.ownerId == resource.data.ownerId;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Perbelanjaan owner (untuk laporan cukai)
    match /expenses/{id} {
      allow read, update, delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isSuper());
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && (!('proof' in request.resource.data) || request.resource.data.proof.size() < 900000);
    }

    // Penyewa — ID dokumen = token link penyewa (rahsia). Penyewa buka tanpa login.
    match /tenants/{tok} {
      allow get: if true;
      allow list: if isSuper() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (resource.data.ownerId == request.auth.uid || isSuper())
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isSuper());

      // Bayaran: penyewa (tanpa login) boleh hantar bukti berstatus 'pending' sahaja
      match /payments/{pid} {
        allow read: if true;
        allow create: if ownsTenant(tok) || (
          request.resource.data.status == 'pending'
          && request.resource.data.tenantId == tok
          && request.resource.data.ownerId == tenant(tok).ownerId
          && tenant(tok).active == true
          && request.resource.data.proof is string
          && request.resource.data.proof.size() < 900000
        );
        allow update: if ownsTenant(tok);
        // resit yang sah / dibatalkan tidak boleh dipadam (rekod audit)
        // (kecuali dipindahkan ke link baru melalui "Tukar link" — salinan mesti sudah wujud)
        // (atau owner pilih "Padam semua data" — tenant ditanda wipe dahulu)
        allow delete: if ownsTenant(tok) && (
          !(resource.data.status in ['confirmed', 'void'])
          || tenant(tok).get('wipe', false) == true
          || (tenant(tok).get('movedTo', '') != '' && exists(/databases/$(database)/documents/tenants/$(tenant(tok).movedTo)/payments/$(pid)))
        );
      }

      // Aduan kerosakan: penyewa (tanpa login) boleh hantar aduan baru; owner kemas kini status
      match /issues/{iid} {
        allow read: if true;
        allow create: if ownsTenant(tok) || (
          request.resource.data.status == 'new'
          && request.resource.data.tenantId == tok
          && request.resource.data.ownerId == tenant(tok).ownerId
          && tenant(tok).active == true
          && request.resource.data.title is string && request.resource.data.title.size() <= 80
          && request.resource.data.updates.size() == 0
          && (!('photo' in request.resource.data) || request.resource.data.photo.size() < 900000)
        );
        allow update, delete: if ownsTenant(tok);
      }

      // Peringatan dari owner kepada penyewa
      match /reminders/{rid} {
        allow read: if true;
        allow write: if ownsTenant(tok);
      }
    }
  }
}
